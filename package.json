{
  "name": "my-new-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "pnpm run build:styles && eleventy",
    "build:styles": "sass scss/styles.scss styles.css --style=expanded --no-source-map",
    "dev": "concurrently --kill-others \"sass --watch scss/styles.scss:styles.css --style=expanded --no-source-map\" \"eleventy --serve\"",
    "test": "node --test"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "concurrently": "^10.0.7",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "sass": "^1.108.2"
  }
}
