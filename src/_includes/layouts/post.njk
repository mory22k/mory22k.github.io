---
layout: layouts/base.njk
currentPage: blog
---
{%- set postRootPath = page.url | relativeRoot -%}

<main id="top">
  <article class="blog-post">
    <header class="post-header">
      <a class="post-back-link" href="{{ postRootPath }}blog/">← 記事一覧</a>
      <h1>{{ postTitle }}</h1>
      <div class="post-meta">
        <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>
        {% if categories %}
          <ul class="category-tags" aria-label="メモのカテゴリ">
            {% for category in categories %}
              <li><a href="{{ category | categoryUrl }}">{{ category }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </header>

    <div class="post-content">
      {{ content | safe }}
    </div>

    <footer class="post-footer">
      <a class="text-link" href="{{ postRootPath }}blog/">← 記事一覧へ戻る</a>
    </footer>
  </article>
</main>
