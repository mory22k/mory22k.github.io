---
layout: layouts/base.njk
pagination:
  data: collections.blogCategories
  size: 1
  alias: category
permalink: "blog/categories/{{ category.slug }}/index.html"
currentPage: blog
eleventyComputed:
  title: "{{ category.name }}の記事一覧 | 森田 圭祐"
  description: "「{{ category.name }}」カテゴリの記事一覧です。"
---

<main id="top">
  <header class="page-header blog-page-header">
    <p class="eyebrow">CATEGORY</p>
    <h1>{{ category.name }}</h1>
    <p>「{{ category.name }}」カテゴリの記事一覧です。</p>
  </header>

  <section class="blog-index" aria-labelledby="articles-title">
    <div class="blog-index-heading">
      <p class="section-index">{{ category.posts.length }} ARTICLES</p>
      <h2 id="articles-title">記事一覧</h2>
    </div>

    <nav class="category-navigation" aria-label="カテゴリ別の記事一覧">
      <span>カテゴリ</span>
      <ul>
        <li><a href="/blog/">すべて</a></li>
        {% for item in collections.blogCategories %}
          <li>
            {% if item.name == category.name %}
              <a href="{{ item.name | categoryUrl }}" aria-current="page">
            {% else %}
              <a href="{{ item.name | categoryUrl }}">
            {% endif %}
              {{ item.name }} <span aria-label="{{ item.posts.length }}件">({{ item.posts.length }})</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    <ol class="blog-list">
      {% for post in category.posts %}
        <li>
          <article class="blog-card">
            <div class="blog-card-meta">
              <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
              {% if post.data.categories %}
                <ul class="category-tags" aria-label="記事のカテゴリ">
                  {% for postCategory in post.data.categories %}
                    <li><a href="{{ postCategory | categoryUrl }}">{{ postCategory }}</a></li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
            <h3><a href="{{ post.url }}">{{ post.data.postTitle }}</a></h3>
            {% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
            <a class="blog-card-link" href="{{ post.url }}" aria-label="「{{ post.data.postTitle }}」を読む">記事を読む <span aria-hidden="true">→</span></a>
          </article>
        </li>
      {% endfor %}
    </ol>
  </section>
</main>
